---
export interface Props {
  title?: string;
  description?: string;
}
import { getCollection } from "astro:content";
import { searchablePages } from "../data/search-pages.js";

const {
  title = "Rahul Jain",
  description = "Rahul Jain — Forward Deployed Engineer at Dassault Systèmes. Data, analytics, and machine learning for enterprise decision-making, with research in reinforcement learning and human cognition.",
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const posts = await getCollection("writing", ({ data }) => !data.draft);
const sitePages = searchablePages.map(([title, path, description]) => ({
  title,
  description,
  tags: [],
  body: "",
  date: "",
  url: base + path,
  fetchUrl: base + path,
}));
const writingIndex = posts.map((post) => ({
  title: post.data.title,
  description: post.data.description,
  tags: post.data.tags ?? [],
  body: post.body,
  date: post.data.pubDate.toISOString(),
  url: base + "writing/" + post.slug + "/",
}));
const serializedSearchIndex = JSON.stringify([...sitePages, ...writingIndex]).replace(/</g, "\\u003c");
const nav = [
  { href: "", label: "Home" },
  { href: "experience/", label: "Experience" },
  { href: "research/", label: "AI & Decision Making Research" },
  { href: "academic/", label: "Academic" },
  { href: "music/", label: "Music" },
  { href: "origins/", label: "Origins" },
  { href: "contact/", label: "Contact" },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div class="header-row">
          <a href={base} class="name">Rahul Jain</a>
          <div class="site-search">
            <form class="search-form" id="search-form" role="search" data-search-index={serializedSearchIndex}>
              <label class="sr-only" for="search-input">Search site</label>
              <input id="search-input" type="search" placeholder="Search site..." autocomplete="off" />
              <button type="submit">Search</button>
            </form>
            <div class="search-popover" id="search-popover" hidden>
              <div class="search-meta" id="search-meta" aria-live="polite">Enter a query and press Search</div>
              <div class="search-results" id="search-results"></div>
              <div class="search-empty" id="search-empty" hidden>No site content matched that search.</div>
            </div>
          </div>
        </div>
        <nav>
          {nav.map((item) => {
            const href = base + item.href;
            const isActive = path === href || (item.href === "" && path === base);
            return <a href={href} class={isActive ? "active" : ""}>{item.label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        &copy; {new Date().getFullYear()} Rahul Jain &middot; <a href={base + "contact/"}>Get in touch</a>
      </div>
    </footer>
    <div class="lightbox-overlay" id="lightbox-overlay">
      <img id="lightbox-overlay-img" src="" alt="" />
    </div>
    <script>
      import "../scripts/site-search.js";
    </script>
  </body>
</html>

<script>
  function setupLightbox() {
    const overlay = document.getElementById("lightbox-overlay");
    const overlayImg = document.getElementById("lightbox-overlay-img");
    if (!overlay || !overlayImg) return;

    document.querySelectorAll("main img").forEach((img) => {
      img.addEventListener("click", () => {
        overlayImg.setAttribute("src", img.getAttribute("src") || "");
        overlayImg.setAttribute("alt", img.getAttribute("alt") || "");
        overlay.classList.add("active");
      });
    });

    const close = () => overlay.classList.remove("active");
    overlay.addEventListener("click", close);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
  }

  setupLightbox();
  document.addEventListener("astro:page-load", setupLightbox);
</script>
