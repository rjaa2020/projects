---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Layout>
  <div class="wrap">
    <header class="site-header">
      <div class="header-top">
        <img class="headshot" src={base + "images/rahul-headshot.jpg"} alt="Rahul Jain" width="140" height="140" />
        <div>
          <div class="name">Rahul Jain</div>
          <div class="tagline">Forward Deployed Engineer, Dassault Systèmes — data pipelines, analytics, and applied ML for enterprise decision-making.</div>
        </div>
      </div>
      <nav>
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#research">Research</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <section id="about">
      <h2 class="section-title">About</h2>
      <p class="lede">
        I work at the intersection of data engineering and business strategy — building the
        pipelines and models, then translating them into decisions executives can act on.
      </p>
      <p>
        I'm currently a Forward Deployed Engineer at Dassault Systèmes, where I partner directly with
        <strong>Fortune 500 engineering organizations</strong> — including Boeing, NVIDIA, and Ford — to scope
        problems, build analytics platforms, and drive adoption of the systems I ship. Before
        that, I built forecasting models for early-stage venture funds, alternative credit-risk
        models for underserved borrowers, and ran a reinforcement-learning benchmarking study
        comparing human and machine learning behavior.
      </p>
      <p>
        I studied Computer Science at <a href="https://www.pomona.edu/" target="_blank" rel="noopener">Pomona College<Icon name="external" /></a>, where my senior thesis compared
        reinforcement-learning agents against human learners on the same skill-learning task —
        using the agent as a baseline to isolate what's actually distinctive about how humans
        generalize and adapt. That thread is still active: I'm a research collaborator with the
        <strong>Allen Institute's Mihalas Lab</strong>, studying memory and retrieval in predictive neural
        networks. Full writeup and publications under <a href={base + "research/"}>AI &amp; Decision
        Making Research</a>.
      </p>
      <p>
        Outside of work, I'm a <strong>tenor saxophonist and jazz bandleader</strong> — and, at a much more
        amateur level, a cyclist, chess player, and weightlifter. I'm also an avid gamer — mostly
        strategic deckbuilders like <em>Slay the Spire</em>, cozy sims like <em>Stardew Valley</em>,
        tightly-designed indies like <em>Hollow Knight</em>, and narrative-driven titles like
        <em>The Last of Us</em>.
      </p>
    </section>

    <section id="experience">
      <h2 class="section-title">Experience</h2>

      <div class="entry">
        <div class="entry-head">
          <div><span class="entry-role">Forward Deployed Engineer</span> <span class="entry-org">· <a href="https://www.3ds.com/" target="_blank" rel="noopener">Dassault Systèmes<Icon name="external" /></a></span></div>
          <div class="entry-date">Jul 2024 – Present</div>
        </div>
        <div class="meta-line">Seattle, WA</div>
        <ul>
          <li>Embed directly with Fortune 500 clients — Boeing, NVIDIA, and Ford — to scope requirements and own end-to-end delivery of analytics systems that inform operational and executive decisions.</li>
          <li>Partner with Ford engineers on the 3DEXPERIENCE Platform to surface part-reuse opportunities and reduce cost rollup across future vehicle production programs.</li>
          <li>Built and deployed a license-utilization platform tracking software adoption across large engineering orgs, then generalized the architecture for rollout to additional clients.</li>
          <li>Automated model-publishing workflows via CI/CD and Python, with testing and failure notifications, eliminating roughly 10 hours per week of manual work.</li>
          <li>Won a company-wide pitch competition for a Humanoid Robotics integration strategy on the 3DEXPERIENCE Platform.</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-head">
          <div><span class="entry-role">ML Research Assistant</span> <span class="entry-org">· <a href="https://www.kecksci.claremont.edu/default.asp" target="_blank" rel="noopener">W.M. Keck Science Center<Icon name="external" /></a></span></div>
          <div class="entry-date">May – Aug 2023</div>
        </div>
        <div class="meta-line">Claremont, CA</div>
        <ul>
          <li>Designed and ran a benchmarking study comparing reinforcement-learning agent behavior against 10,000+ human players, identifying systematic differences in learning strategy, persistence, and trajectory shape.</li>
          <li>Presented findings at the <a href="https://www.neuromonster.org/nm2023" target="_blank" rel="noopener">International Symposium on the Mathematics of Neuroscience<Icon name="external" /></a> in Rhodes, Greece.</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-head">
          <div><span class="entry-role">Data Analyst Intern</span> <span class="entry-org">· <a href="https://www.mvp-vc.com/" target="_blank" rel="noopener">Modern Venture Partners<Icon name="external" /></a></span></div>
          <div class="entry-date">Nov 2022 – Jun 2023</div>
        </div>
        <div class="meta-line">Menlo Park, CA</div>
        <ul>
          <li>Built and trained a PyTorch RNN forecasting funding trends across 2,000+ startups; presented findings directly to firm partners to inform investment strategy.</li>
          <li>Engineered SQL ETL workflows processing 900,000+ investment records, applying PCA and statistical analysis to surface portfolio signals.</li>
        </ul>
      </div>

      <div class="entry">
        <div class="entry-head">
          <div><span class="entry-role">Data Analyst Intern</span> <span class="entry-org">· <a href="https://www.levelgoals.com/" target="_blank" rel="noopener">Level Goals<Icon name="external" /></a></span></div>
          <div class="entry-date">May – Aug 2022</div>
        </div>
        <div class="meta-line">Seattle, WA</div>
        <ul>
          <li>Developed a credit-score-free risk model using behavioral signals — income consistency, gig-employment history — to assess default likelihood for underserved borrowers.</li>
          <li>Built 8 executive-facing dashboards covering acquisition, A/B test results, and loan-repayment KPIs.</li>
        </ul>
      </div>

      <p style="margin-top:8px;"><a href={base + "experience/"}>Full experience &rarr;</a></p>
    </section>

    <section id="projects">
      <h2 class="section-title">Projects</h2>
      <p class="lede">Side projects outside my day job — for the fuller research story, see below.</p>

      <div class="project-card">
        <div class="project-title">
          <span>Woodshed</span>
          <span class="project-date">Winter 2026</span>
        </div>
        <p class="project-desc">
          An adaptive ear-training quiz app for seventh-chord note naming, built around a Python
          engine that's the single source of truth for chord logic, served via FastAPI to a Node.js
          web GUI. Includes a Circle-of-Fifths key selector, adaptive prompt sampling weighted toward
          weaker key/quality pairs, and <strong>Jazz 1460 iReal chart integration</strong> for song-specific practice. Live at <a href="https://woodshed-195c.onrender.com" target="_blank" rel="noopener">woodshed-195c.onrender.com<Icon name="external" /></a> &middot; <a href="https://github.com/rjaa2020/projects/tree/Woodshed/Woodshed" target="_blank" rel="noopener">Open source on GitHub<Icon name="external" /></a>.
        </p>
        <div class="tag-row">
          <span class="tag">Python</span>
          <span class="tag">FastAPI</span>
          <span class="tag">Music Theory</span>
          <span class="tag">Ear Training</span>
        </div>
      </div>

      <div class="project-card">
        <div class="project-title">
          <span>Mizen</span>
          <span class="project-date">Winter 2025</span>
        </div>
        <p class="project-desc">
          A dual-layer retrieval-augmented generation pipeline — JSON-LD schema enforcement backed
          by a Llama 3.3-70B fallback — that extracts and normalizes structured recipe data from
          <strong>1,000+ live web sources</strong>. In production at <a href="https://mizen.recipes" target="_blank" rel="noopener">mizen.recipes</a>.
        </p>
        <div class="tag-row">
          <span class="tag">RAG</span>
          <span class="tag">LLM</span>
          <span class="tag">JSON-LD</span>
          <span class="tag">Llama 3.3</span>
        </div>
      </div>

      <div class="project-card">
        <div class="project-title">
          <span>Medley Vox</span>
          <span class="project-date">Fall 2023</span>
        </div>
        <p class="project-desc">
          Multi-singer detection and speaker diarization: an RNN model identifying overlapping
          vocal identities using 512-dimensional SpeechBrain x-vector embeddings, <strong>outperforming
          two established benchmarks</strong> on held-out test data.
        </p>
        <div class="tag-row">
          <span class="tag">RNN</span>
          <span class="tag">Speaker Diarization</span>
          <span class="tag">SpeechBrain</span>
        </div>
      </div>

      <p style="margin-top:8px;"><a href={base + "experience/"}>More side projects &rarr;</a></p>
    </section>

    <section id="research">
      <h2 class="section-title">AI &amp; Decision Making Research</h2>
      <p>
        My senior thesis and ongoing work start from the same premise: human intelligence is
        remarkably flexible in ways today's algorithms aren't, and reinforcement-learning agents are
        a useful baseline for isolating what's actually different about it. I benchmarked RL agents
        against <strong>10,000+ human players</strong> on a complex skill-learning task, presented the findings at the
        <a href="https://www.neuromonster.org/nm2023" target="_blank" rel="noopener">International Symposium on the Mathematics of Neuroscience<Icon name="external" /></a>, and I'm now continuing the same
        thread as a research collaborator with the <strong>Allen Institute's Mihalas Lab</strong>, studying memory and
        retrieval in predictive neural networks.
      </p>
      <p style="margin-top:8px;"><a href={base + "research/"}>Full research writeup &amp; publications &rarr;</a></p>
    </section>

    <section id="skills">
      <h2 class="section-title">Skills</h2>
      <dl class="skills-grid">
        <dt>Languages</dt>
        <dd>Python, SQL (PostgreSQL), R, Java, JavaScript, Bash, PowerShell</dd>
        <dt>ML &amp; AI</dt>
        <dd>PyTorch, TensorFlow, Scikit-learn, RAG pipelines, LLM deployment, prompt engineering, RL benchmarking, PCA</dd>
        <dt>Tools</dt>
        <dd>Metabase, Retool, Tableau, GitLab, Jupyter, GCP, AWS, Pandas, NumPy</dd>
        <dt>Education</dt>
        <dd>B.A. Computer Science, <a href="https://www.pomona.edu/" target="_blank" rel="noopener">Pomona College<Icon name="external" /></a> (2024) — research in computational cognitive science and reinforcement learning</dd>
      </dl>
    </section>

    <section id="contact">
      <h2 class="section-title">Contact</h2>
      <p>Based in Seattle, WA. Open to conversations about strategy &amp; analytics roles, data platforms, and applied ML.</p>
      <div class="contact-links">
        <a href="mailto:rjaa2024@gmail.com">Email</a>
        <a href="https://linkedin.com/in/rahulj24" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/rjaa2020" target="_blank" rel="noopener">GitHub</a>
      </div>
    </section>

    <footer>&copy; {year} Rahul Jain</footer>
  </div>
</Layout>
