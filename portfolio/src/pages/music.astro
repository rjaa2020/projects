---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Layout title="Music — Rahul Jain">
  <div class="wrap">
    <h1 class="page-title">Tenor Saxophonist &amp; Bandleader</h1>

    <div class="photo-row">
      <img class="page-photo" src={base + "images/rahul-saxophone.jpg"} alt="Rahul Jain playing tenor saxophone on stage" width="792" height="1161" />
      <img class="page-photo" src={base + "images/rahul-saxophone-band.jpg"} alt="Rahul Jain performing tenor saxophone with a jazz band" width="652" height="794" />
      <img class="page-photo" src={base + "images/rahul-saxophone-group.jpg"} alt="Rahul Jain performing tenor saxophone with a group on stage" width="900" height="579" />
    </div>

    <section>
      <div class="entry">
        <div class="entry-head"><div class="entry-role">The Maple Leaves</div><div class="entry-date">Winter 2025</div></div>
        <p class="project-desc">Tenor saxophonist in this five-piece combo through the <a href="https://www.seattlejazzacademy.com/teachers/conner-helms" target="_blank" rel="noopener">Seattle Jazz Academy<Icon name="external" /></a>, led by Conner Helms.</p>
      </div>
      <div class="entry">
        <div class="entry-head"><div class="entry-role">Reading Days</div><div class="entry-date">Spring 2024</div></div>
        <p class="project-desc">Bandleader for this jazz quintet, merging artistic direction with the logistical management of running a band — bookings, rehearsals, and keeping five people's schedules aligned.</p>
      </div>
      <div class="entry">
        <div class="entry-head"><div class="entry-role"><a href="https://www.seattlejazzed.org/" target="_blank" rel="noopener">Seattle JazzED<Icon name="external" /></a></div><div class="entry-date">2018&ndash;2020</div></div>
        <p class="project-desc">"Jazz Ambassador," mentoring middle-school students and leading daily sectionals to build technical musicianship — my first experience leading and teaching musicians rather than just playing alongside them.</p>
      </div>
      <div class="entry">
        <div class="entry-head"><div class="entry-role">Bellevue High School Jazz Ensemble I &amp; Wind Ensemble</div><div class="entry-date">2016&ndash;2020</div></div>
        <p class="project-desc"><strong>Lead tenor saxophonist and section leader</strong> across both ensembles, managing rehearsal schedules and driving unity across the group.</p>
      </div>
      <p class="blurb" style="margin-top:20px;">
        I keep coming back to the same idea in both jazz and in my technical work: <strong>real creativity shows
        up inside constraints</strong> — a chord structure, a data schema, a client's actual budget — not in
        ignoring them. Years of improvising within a set of rules is probably why I default to that way of
        thinking everywhere else.
      </p>
    </section>
  </div>
</Layout>
