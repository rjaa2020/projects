---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Layout title="Graphite Group — Rahul Jain">
  <div class="wrap">
    <a class="back-link" href={base + "origins/"}>&larr; Origins</a>
    <h1 class="page-title"><a href="https://www.graphitegroup.co/" target="_blank" rel="noopener">Graphite Group<Icon name="external" /></a></h1>
    <p class="page-lede">Student-run consulting firm across the Claremont Colleges &middot; 2020&ndash;2022</p>
    <section>
      <p class="blurb">
        Graphite Group is a student-run consulting firm spanning the five Claremont Colleges, split
        between a <strong>strategy practice</strong> (market entry, positioning, pricing) and a <strong>digital practice</strong> (software,
        data, product design). My engagements ranged more widely than most of what's on this site — which
        was kind of the point of doing it.
      </p>

      <div class="entry">
        <div class="entry-head"><div class="entry-role"><a href="https://bereal.com/" target="_blank" rel="noopener">BeReal<Icon name="external" /></a> user-acquisition campaign</div></div>
        <p class="project-desc">Ran a <strong>growth campaign</strong> signing up new users across the Claremont Colleges.</p>
      </div>
      <div class="entry">
        <div class="entry-head"><div class="entry-role">Luxury resort acquisition — financial forecast</div></div>
        <p class="project-desc">Built a <strong>financial forecast</strong> evaluating the acquisition of a luxury resort in Eastern Washington.</p>
      </div>
      <div class="entry">
        <div class="entry-head"><div class="entry-role">Celo mobile money launch</div></div>
        <p class="project-desc">Supported the launch of <a href="https://celo.org/" target="_blank" rel="noopener">Celo<Icon name="external" /></a>-based <strong>mobile money transfers</strong> for small-business transactions in developing markets.</p>
      </div>
      <div class="entry">
        <div class="entry-head"><div class="entry-role">Luxury pet-breeding facility — operations consulting</div></div>
        <p class="project-desc">Diagnosed where team synergy was breaking down and where money was being lost, through <strong>financial forecasting and staff interviews</strong>.</p>
      </div>
    </section>
  </div>
</Layout>
