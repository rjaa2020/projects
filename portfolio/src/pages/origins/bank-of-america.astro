---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Layout title="Bank of America National Civic Leadership Program — Rahul Jain">
  <div class="wrap">
    <a class="back-link" href={base + "origins/"}>&larr; Origins</a>
    <h1 class="page-title">Bank of America National Civic Leadership Program</h1>
    <p class="page-lede">One of five students selected in Washington State &middot; Summer 2019</p>
    <section>
      <p class="blurb">
        Selected as one of only five students statewide, I attended a <strong>national leadership summit in
        Washington, D.C.</strong>, alongside a strategic internship placement at <a href="https://imaginehousing.org/" target="_blank" rel="noopener">Imagine Housing<Icon name="external" /></a>, a
        regional affordable-housing nonprofit serving roughly <strong>1,400 residents — nearly 500 of them under
        18 — across 15 properties</strong> on Seattle's Eastside. It was a striking data point for a neighborhood
        usually described as affluent: a large share of renters and homeowners there were still
        cost-burdened, spending more than 30% of their income on housing.
      </p>
      <p class="blurb">
        The internship put me in board meetings and long-term planning sessions I had no business being
        in as a high schooler — which was the point. I brought a student's perspective to those
        conversations, and worked directly with department heads on <strong>resident-information projects,
        event planning, and donor engagement</strong> — the unglamorous work of keeping a nonprofit's mission
        funded and its residents connected to each other. It was my first real look at how a nonprofit's
        mission gets translated (or doesn't) into <strong>executive-level planning and budget decisions</strong>.
      </p>
    </section>
  </div>
</Layout>
