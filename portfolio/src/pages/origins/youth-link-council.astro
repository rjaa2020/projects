---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
---
<Layout title="Youth Link Council — Rahul Jain">
  <div class="wrap">
    <a class="back-link" href={base + "origins/"}>&larr; Origins</a>
    <h1 class="page-title"><a href="https://bellevuewa.gov/" target="_blank" rel="noopener">Bellevue City Hall<Icon name="external" /></a> Youth Link Council</h1>
    <p class="page-lede">Volunteer board member, then advisory role</p>
    <section>
      <p class="blurb">
        My first year on the council was an eye-opening education in <strong>how legislative decision-making
        actually happens</strong> — sitting through the unglamorous, procedural reality of municipal government
        rather than the abstract version you get from a civics class. I eventually moved into an advisory
        role, guiding city leaders on policy issues around <strong>youth equity, regional diversity</strong>, and how the
        city allocated its resources.
      </p>
      <p class="blurb">
        The bigger takeaway was less about policy specifics and more about agency: watching how much of
        what gets called "leadership" is really just <strong>students choosing to take initiative</strong> rather than
        waiting to be asked. That's stuck with me since.
      </p>
    </section>
  </div>
</Layout>
